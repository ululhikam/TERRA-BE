# Server Configuration
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Comma-separated allowed frontend origins (e.g. http://localhost:5173,https://terra-concern.vercel.app)
CORS_ORIGIN=http://localhost:5173,https://terra-concern.vercel.app
FRONTEND_URL=https://terra-concern.vercel.app

# QR PDF Download Signing Secret
QR_SIGNING_SECRET=terra-dev-qr-signing-secret-2026

# Supabase Project Credentials (Project Settings -> API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=terra-media
SUPABASE_DOCS_BUCKET=terra-documents

# PostgreSQL / Supabase Connection Strings for Prisma ORM (Connect -> ORMs -> Prisma)
# DATABASE_URL uses Transaction Pooler (port 6543, ?pgbouncer=true) for serverless/app queries
# DIRECT_URL uses Direct Connection (port 5432) for `prisma migrate`
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres:[YOUR-DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Resend Email API (https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Terra <no-reply@concern.web.id>"

# Optional SMTP fallback for Ticket QR Email Delivery (leave empty for local outbox preview)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TERRA Tickets <tickets@terra.id>

# Google OAuth 2.0 via Passport.js (Google Cloud Console -> Credentials -> OAuth Client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://backend-six-sand-66.vercel.app/api/v1/auth/google/callback
OAUTH_JWT_SECRET=

# Admin WhatsApp Number for Organizer Subscription Activation (628xxxx without +)
ADMIN_WHATSAPP_NUMBER=6287897192601

# Midtrans Payment Gateway (https://dashboard.midtrans.com -> Settings -> Access Keys)
# Set MIDTRANS_IS_PRODUCTION=false for Sandbox, true for Production
# Webhook Notification URL in Midtrans Dashboard: https://<your-backend-domain>/api/v1/payments/midtrans/webhook
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
